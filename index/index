.grid>.btn{position:relative;z-index:1;width:min(78%,430px)}
.grid>.btn:nth-child(odd){align-self:flex-start}
.grid>.btn:nth-child(even){align-self:flex-end}
.grid>.btn::after{content:"";position:absolute;top:50%;width:12px;height:12px;border-radius:50%;background:var(--acc);box-shadow:0 0 0 4px var(--card);transform:translateY(-50%)}
.grid>.btn:nth-child(odd)::after{right:-6px}
.grid>.btn:nth-child(even)::after{left:-6px}
